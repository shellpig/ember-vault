{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p workers/room",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:full": "concurrently -k -n room,api,web -c yellow,cyan,magenta \"npm:dev:room\" \"npm:dev:api\" \"npm:dev\"",
    "dev:room": "wrangler dev -c workers/room/wrangler.toml --port 8787 --inspector-port 9229 --persist-to .wrangler/state",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler pages dev dist --port 8788 --do ROOM=Room@ember-vault-room --persist-to .wrangler/state",
    "deploy:room": "wrangler deploy -c workers/room/wrangler.toml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
