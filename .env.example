# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- P1 account / cloud save (see docs/p1-setup.md) ---------------------------
# Google OAuth Web client id used by the frontend (Google Identity Services).
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
# NOTE: the backend (Pages Functions) reads GOOGLE_CLIENT_ID (same value) from
#   - production / preview: Cloudflare Pages project -> Settings -> Variables and Secrets
#   - local `npm run dev:full`: a `.dev.vars` file (git-ignored), e.g.
#       GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
#       DEV_AUTH=1
#   DEV_AUTH=1 enables POST /api/auth/dev (fake login). NEVER set it in production.
